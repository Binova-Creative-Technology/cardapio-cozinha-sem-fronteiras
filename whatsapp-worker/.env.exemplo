# Copie este arquivo para ".env" (sem o .exemplo) e preencha os dois dados abaixo.
# Eles aparecem na aba "WhatsApp" do painel, no quadro "Como instalar o programa do WhatsApp".

# Endereço do sistema, sem barra no final
SISTEMA_URL=https://restaurante.emporiosemfronteiras.com.br

# Chave de acesso (copie da aba WhatsApp do painel; não mostre para ninguém)
CHAVE=

# Opcional: limites para não parecer robô (reduzem o risco de o número ser bloqueado)
# MAX_POR_HORA=20
# PAUSA_MIN_S=20
# PAUSA_MAX_S=45
